extends RefCounted
func run(check, tree) -> void:
 check.case("initial_day_and_inactive_title")
 var path := "res://game/app/game_session.gd"
 check.is_true(FileAccess.file_exists(path))
 if not FileAccess.file_exists(path): return
 var store := ContentStore.new()
 check.is_true(store.load_directory("res://content").ok)
 var config = load("res://game/app/session_config.gd").new(store.bundle(),store.fingerprint,store.source_root)
 var session: GameSession = load(path).new()
 tree.root.add_child(session)
 check.is_true(session.configure(config).ok)
 session.tick(1.0)
 var start := session.clock.snapshot()
 var balances := store.section("balance")
 var needs := store.section("needs")
 check.near(session.clock.minutes,float(store.section("time").start_minutes))
 check.equal(session.wallet.balance,int(balances.starting_money))
 session.start_new()
 session.tick(1.0)
 var elapsed := float(store.section("time").minutes_per_second)
 check.near(session.clock.world_minutes,float(start.world_minutes)+elapsed)
 check.near(session.needs.hunger,float(needs.initial.hunger)-float(needs.hunger_decay)*elapsed)
 check.near(session.needs.rest,float(needs.initial.rest)-float(needs.rest_decay)*elapsed)
 check.case("failed_spend_and_invalid_money_are_atomic")
 var before: int = session.wallet.balance
 check.is_true(not session.wallet.try_spend(before+1).ok)
 check.is_true(not session.wallet.try_spend(-1).ok)
 check.is_true(not session.wallet.credit(-1).ok)
 check.equal(session.wallet.balance,before)
 check.case("unique_knowledge_and_provenance")
 check.is_true(session.knowledge.learn(&"KNOWN_CHEAP_FAN","عرفت مصلحة","amgad"))
 check.is_true(not session.knowledge.learn(&"KNOWN_CHEAP_FAN","مكرر","amgad"))
 check.equal(session.knowledge.notes().size(),2)
 check.case("sleep_recovers_with_running_placed_fan_without_legacy_rent_debit")
 check.is_true(session.home.install_fan().ok)
 check.is_true(not session.home.fan_on)
 var fan: Dictionary=session.items.instances(&"fan")[0]
 var request := PlacementRequest.from_dict({"instance_id":fan.id,"location_id":"rooftop","cell":[2,-3],"rotation":0,"host_id":"","slot_id":""})
 check.is_true(session.spaces.place(request).ok)
 check.is_true(session.home.toggle_fan().ok)
 check.is_true(session.home.fan_on)
 var hours := int(store.section("wellbeing").sleep.maximum_hours)
 var preview := session.routine.preview(hours)
 check.is_true(preview.ok)
 var wallet_before := session.wallet.balance
 check.is_true(session.routine.sleep(hours).ok)
 check.equal(session.clock.day,int(preview.details.wake_day))
 check.near(session.clock.minutes,float(preview.details.wake_minutes))
 check.equal(session.wallet.balance,wallet_before)
 check.is_true(not session.routine.rent_enabled)
 check.near(session.needs.baseline,float(needs.sleep.fan_baseline))
 check.near(session.needs.rest,100)
 check.case("sleep_invalid_duration_is_atomic_and_empty_wallet_does_not_block_rest")
 var clock_before := session.clock.snapshot()
 var needs_before := session.needs.snapshot()
 check.is_true(not session.routine.sleep(int(store.section("wellbeing").sleep.minimum_hours)-1).ok)
 check.equal(session.clock.snapshot(),clock_before)
 check.equal(session.needs.snapshot(),needs_before)
 check.is_true(session.wallet.try_spend(session.wallet.balance).ok)
 check.is_true(session.routine.sleep(hours).ok)
 check.equal(session.wallet.balance,0)
 session.queue_free()
 store.free()
 await tree.process_frame
