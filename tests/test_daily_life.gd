extends RefCounted
func run(check, tree) -> void:
 check.case("initial_day_and_inactive_title")
 var path := "res://game/app/game_session.gd"
 check.is_true(FileAccess.file_exists(path))
 if not FileAccess.file_exists(path): return
 var store := ContentStore.new()
 check.is_true(store.load_directory("res://content").ok)
 var config = load("res://game/app/session_config.gd").new(store.bundle(),store.fingerprint,store.source_root)
 var session = load(path).new()
 tree.root.add_child(session)
 check.is_true(session.configure(config).ok)
 session.tick(1.0)
 check.near(session.clock.minutes,930.0)
 check.equal(session.wallet.balance,4500)
 session.start_new()
 session.tick(1.0)
 check.near(session.clock.minutes,932.5)
 check.near(session.needs.hunger,79.72)
 check.near(session.needs.rest,89.85)
 check.case("failed_spend_and_invalid_money_are_atomic")
 var before: int = session.wallet.balance
 check.is_true(not session.wallet.try_spend(99999).ok)
 check.is_true(not session.wallet.try_spend(-1).ok)
 check.is_true(not session.wallet.credit(-1).ok)
 check.equal(session.wallet.balance,before)
 check.case("unique_knowledge_and_provenance")
 check.is_true(session.knowledge.learn(&"KNOWN_CHEAP_FAN","عرفت مصلحة","amgad"))
 check.is_true(not session.knowledge.learn(&"KNOWN_CHEAP_FAN","مكرر","amgad"))
 check.equal(session.knowledge.notes().size(),2)
 check.case("rent_and_fan_sleep")
 session.home.install_fan()
 check.is_true(session.routine.sleep(12).ok)
 check.equal(session.clock.day,2)
 check.near(session.clock.minutes,212.5)
 check.equal(session.wallet.balance,3000)
 check.near(session.needs.baseline,82)
 check.near(session.needs.rest,100)
 session.wallet.try_spend(3000)
 session.routine.sleep(12)
 check.equal(session.wallet.balance,0)
 session.queue_free()
 store.free()
 await tree.process_frame
