extends RefCounted
func run(check, tree) -> void:
 var store := ContentStore.new()
 check.is_true(store.load_directory("res://content").ok)
 var locale := LocaleService.new()
 check.is_true(locale.configure(store.bundle()).ok)
 var text := UiText.new(store.section("ui"))
 check.case("cozy_theme_shared_semantic_styles_and_contrast")
 var first := text.make_theme()
 check.is_true(first==text.make_theme())
 check.is_true(first.has_stylebox("focus","Button"))
 check.is_true(first.has_stylebox("disabled","Button"))
 check.is_true(first.has_stylebox("normal","LineEdit"))
 check.is_true(first.has_stylebox("panel","Card"))
 var foreground := first.get_color("font_color","Label").srgb_to_linear().get_luminance()
 var background: float=first.get_stylebox("panel","PanelContainer").bg_color.srgb_to_linear().get_luminance()
 check.is_true((background+0.05)/(foreground+0.05)>=7.0)
 check.case("keyboard_buttons_and_locale_alignment")
 var button := UiText.button("Example",func():pass)
 check.equal(button.focus_mode,Control.FOCUS_ALL)
 await locale.set_locale("ar_EG")
 var label := SheetControls.label("أهلاً")
 tree.root.add_child(label)
 UiText.refresh_tree(label)
 check.equal(label.horizontal_alignment,HORIZONTAL_ALIGNMENT_RIGHT)
 locale.set_locale("en")
 UiText.refresh_tree(label)
 check.equal(label.horizontal_alignment,HORIZONTAL_ALIGNMENT_LEFT)
 button.free();label.free();store.free()
