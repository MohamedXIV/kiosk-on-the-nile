extends RefCounted
func run(check, _tree) -> void:
 check.case("real_cooking_service_exists")
 var path := "res://game/cooking/cooking_service.gd"
 check.is_true(FileAccess.file_exists(path))
 if not FileAccess.file_exists(path): return
 var store := ContentStore.new()
 check.is_true(store.load_directory("res://content").ok)
 var config: Dictionary = store.section("recipes")
 var Cooking = load(path)
 var cooking = Cooking.new()
 check.is_true(cooking.configure(config).ok)
 check.case("good_tea_sugar_and_exact_stock")
 check.equal(cooking.stock_count(&"tea"),6)
 check.is_true(cooking.cycle_sugar(&"tea").ok)
 check.equal(cooking.job(&"tea").sugar_id,&"extra")
 cooking.act(&"tea")
 check.equal(cooking.stock_count(&"tea"),6)
 cooking.tick(3.5)
 cooking.act(&"tea")
 check.equal(cooking.stock_count(&"tea"),5)
 cooking.tick(3.0)
 cooking.act(&"tea")
 check.equal(cooking.held_item().quality_score,3)
 check.equal(cooking.held_item().sugar_id,&"extra")
 check.equal(cooking.job(&"tea").sugar_id,&"regular")
 cooking.take_held(cooking.held_item().id)
 check.case("overbrewed_tea_quality")
 for fixture in [[9.0,2],[13.0,1]]:
  cooking.act(&"tea"); cooking.tick(3.5); cooking.act(&"tea"); cooking.tick(fixture[0]); cooking.act(&"tea")
  check.equal(cooking.held_item().quality_score,fixture[1])
  cooking.take_held(cooking.held_item().id)
 check.case("manual_kebda_early_flip_good_and_burnt")
 cooking.act(&"kebda")
 var before: Dictionary = cooking.snapshot()
 check.equal(cooking.act(&"kebda").code,ActionResult.Code.TOO_EARLY)
 check.equal(cooking.snapshot(),before)
 cooking.tick(3.0);cooking.act(&"kebda");cooking.tick(3.0);cooking.act(&"kebda");cooking.act(&"kebda")
 check.equal(cooking.held_item().quality_score,3)
 cooking.take_held(cooking.held_item().id)
 cooking.act(&"kebda");cooking.tick(16.0);cooking.act(&"kebda");cooking.act(&"kebda");cooking.act(&"kebda")
 check.equal(cooking.held_item().quality_score,0)
 check.case("occupied_hands_reject_without_mutation")
 cooking.act(&"tea");cooking.tick(3.5);cooking.act(&"tea");cooking.tick(3.0)
 before = cooking.snapshot()
 check.equal(cooking.act(&"tea").code,ActionResult.Code.HANDS_BUSY)
 check.equal(cooking.snapshot(),before)
 check.case("independent_stations_never_double_consume_last_portion")
 var limited: Dictionary = config.duplicate(true)
 limited.initial_stock.tea = 1
 limited.stations.tea2 = {"recipe_id":"tea"}
 var parallel = Cooking.new()
 check.is_true(parallel.configure(limited).ok)
 parallel.act(&"tea");parallel.act(&"tea2");parallel.tick(4.0)
 parallel.act(&"tea")
 before = parallel.snapshot()
 check.equal(parallel.act(&"tea2").code,ActionResult.Code.OUT_OF_STOCK)
 check.equal(parallel.snapshot(),before)
 check.equal(parallel.stock_count(&"tea"),0)
 check.case("mid_brew_restore_retains_timers_options_and_unique_ids")
 var resumed = Cooking.new()
 resumed.configure(limited)
 check.is_true(resumed.restore(parallel.snapshot()).ok)
 parallel.tick(3);resumed.tick(3)
 parallel.act(&"tea");resumed.act(&"tea")
 check.equal(resumed.snapshot(),parallel.snapshot())
 check.equal(config.initial_stock.tea,6)
 check.case("impossible_saved_stage_and_reused_item_id_are_atomic_rejections")
 var valid: Dictionary = parallel.snapshot()
 var bad: Dictionary = valid.duplicate(true)
 bad.jobs.kebda.stage = "SIDE_B"
 check.is_true(not resumed.restore(bad).ok)
 check.equal(resumed.snapshot(),valid)
 resumed.restore(valid)
 bad = valid.duplicate(true)
 bad.held.id = "food_" + str(bad.next_item)
 check.is_true(not resumed.restore(bad).ok)
 check.equal(resumed.snapshot(),valid)
 check.case("external_timing_change_preserves_active_job_then_applies_to_next_job")
 var active = Cooking.new()
 active.configure(config)
 active.act(&"tea");active.tick(1)
 var tuned: Dictionary = config.duplicate(true)
 tuned.recipes.tea.timing.boil_seconds = 10.0
 var updated = Cooking.new()
 updated.configure(tuned)
 check.is_true(updated.restore(active.snapshot()).ok)
 updated.tick(3)
 check.equal(updated.job(&"tea").stage,&"BOILED")
 updated.act(&"tea");updated.tick(3);updated.act(&"tea")
 updated.take_held(updated.held_item().id)
 updated.act(&"tea");updated.tick(4)
 check.equal(updated.job(&"tea").stage,&"HEATING")
 store.free()
